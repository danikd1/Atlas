# Скопируй этот файл в .env и заполни значения
# cp .env.example .env

# ─── Окружение ────────────────────────────────────────────────────────────────
# "production" — Swagger UI (/docs, /redoc) отключён
# "development" — Swagger UI доступен на /docs и /redoc
ENVIRONMENT=production

# ─── База данных ──────────────────────────────────────────────────────────────
# Для Docker: POSTGRES_HOST=db (имя сервиса в docker-compose.yml)
# Для локальной разработки: POSTGRES_HOST=localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=сложный_пароль_минимум_16_символов

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Случайная строка минимум 32 символа
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=замени_на_случайную_строку_минимум_32_символа

# ─── GigaChat ─────────────────────────────────────────────────────────────────
GIGACHAT_CREDENTIALS=твои_credentials_из_личного_кабинета_sber

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Домен фронтенда — через запятую если несколько
ALLOWED_ORIGINS=https://твой-домен.ru

# ─── Ограничение регистрации ──────────────────────────────────────────────────
# ВАЖНО ДЛЯ ПРОДАКШЕНА: заполни список разрешённых email, иначе регистрация
# будет открыта для всех пользователей интернета.
# Email через запятую — только эти адреса смогут зарегистрироваться.
# Пример: ALLOWED_EMAILS=user1@gmail.com,user2@company.ru
ALLOWED_EMAILS=user@example.com

# ─── Воркеры ──────────────────────────────────────────────────────────────────
# В docker-compose.yml эти переменные переопределяются через environment:
# (worker-collector → http://worker-collector:8001 и т.д.)
# Здесь оставь как есть — используется только при локальном запуске без Docker
WORKER_COLLECTOR_URL=http://localhost:8001
WORKER_EXTRACTION_URL=http://localhost:8002
WORKER_RAG_URL=http://localhost:8003
